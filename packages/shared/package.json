{
  "name": "@ez-english/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"tsup.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tsup.config.ts\""
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "tsup": "^8.5.0",
    "typescript": "~5.7.0"
  }
}
